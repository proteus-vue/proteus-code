# Rust 构建产物
target/
**/target/

# 编辑器 / 系统
.DS_Store
*.swp

# 运行时会话数据（本地状态，不入库）
.neo/
.neo-home/

# 外部资源缓存（ai-efficiency-rules 的 cache_fetch.sh 默认落这里）
.cache/

# npm（npm/ 包装层用；打包/安装产物不入库）
node_modules/
*.tgz
npm-debug.log*

# 官网构建产物（website/ 的 dist 由 npm run build 生成）
website/dist/

# 桌面 .app 打包产物（scripts/make-app.sh 生成；不入库，构建可复现）
dist/

# 工具生成的本地目录（ZCode 的计划缓存等，非项目内容）
.zcode/

# Python 字节码缓存。检查脚本之间会相互 `import`（可开源集清单只有一处定义，
# 所以 check_extractable / check_licenses 都从 check_ui_layering 读），
# 因此运行门禁就会生成 __pycache__。
__pycache__/
*.pyc
